// ============================================================================
// TAIRÚGO - Prisma Schema com Extensão PostGIS
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

enum UserRole {
  TOURIST
  MERCHANT
  ADMIN
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PoiOwnership {
  PUBLIC
  PRIVATE
}

model User {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                String          @db.VarChar(150)
  email               String          @unique @db.VarChar(150)
  passwordHash        String?         @map("password_hash") @db.VarChar(255)
  oauthProvider       String?         @map("oauth_provider") @db.VarChar(50)
  avatarUrl           String?         @map("avatar_url")
  role                UserRole        @default(TOURIST)
  cnpj                String?         @unique @db.VarChar(18)
  businessLicenseUrl  String?         @map("business_license_url")
  verificationStatus  MerchantStatus? @default(PENDING) @map("verification_status")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownedPois           Poi[]
  reviews             Review[]
  favorites           UserFavorite[]
  uploadedPhotos      PoiPhoto[]

  @@map("users")
}

model Category {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(60)
  name         String   @db.VarChar(100)
  iconName     String   @map("icon_name") @db.VarChar(60)
  isCommercial Boolean  @default(false) @map("is_commercial")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pois         Poi[]

  @@map("categories")
}

model Poi {
  id                 String                                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String                                @db.VarChar(180)
  slug               String                                @unique @db.VarChar(200)
  description        String
  shortDescription   String?                               @map("short_description") @db.VarChar(280)
  categoryId         Int                                   @map("category_id")
  ownership          PoiOwnership                          @default(PUBLIC)
  ownerId            String?                               @map("owner_id") @db.Uuid
  // Tipo espacial nativo do PostGIS SRID 4326 (WGS 84)
  location           Unsupported("geometry(Point, 4326)")
  address            String?                               @db.VarChar(255)
  openingHours       String                                @default("Livre (24h)") @map("opening_hours") @db.VarChar(100)
  entryFee           String                                @default("Gratuita") @map("entry_fee") @db.VarChar(100)
  requiresGuide      Boolean                               @default(false) @map("requires_guide")
  accessibilityRules Json                                  @default("{}") @map("accessibility_rules")
  isOpenNow          Boolean                               @default(true) @map("is_open_now")
  phoneWhatsapp      String?                               @map("phone_whatsapp") @db.VarChar(30)
  digitalMenu        Json                                  @default("[]") @map("digital_menu")
  ratingAvg          Decimal                               @default(0.00) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                                   @default(0) @map("rating_count")
  isFeatured         Boolean                               @default(false) @map("is_featured")
  isActive           Boolean                               @default(true) @map("is_active")
  createdAt          DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)

  category           Category                              @relation(fields: [categoryId], references: [id])
  owner              User?                                 @relation(fields: [ownerId], references: [id])
  photos             PoiPhoto[]
  reviews            Review[]
  favoritedBy        UserFavorite[]
  metrics            PoiMetric[]

  @@index([location], name: "idx_pois_location_gist", type: Gist)
  @@map("pois")
}

model PoiPhoto {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  poiId         String   @map("poi_id") @db.Uuid
  uploadedBy    String?  @map("uploaded_by") @db.Uuid
  urlWebp       String   @map("url_webp")
  thumbnailWebp String   @map("thumbnail_webp")
  blurhash      String?  @db.VarChar(100)
  isCover       Boolean  @default(false) @map("is_cover")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  poi           Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  uploader      User?    @relation(fields: [uploadedBy], references: [id])

  @@map("poi_photos")
}

model Review {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  poiId             String    @map("poi_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  rating            Int       @db.SmallInt
  comment           String
  merchantReply     String?   @map("merchant_reply")
  merchantRepliedAt DateTime? @map("merchant_replied_at") @db.Timestamptz(6)
  isApproved        Boolean   @default(true) @map("is_approved")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  poi               Poi       @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poiId, userId])
  @@map("reviews")
}

model UserFavorite {
  userId    String   @map("user_id") @db.Uuid
  poiId     String   @map("poi_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poi       Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@id([userId, poiId])
  @@map("user_favorites")
}

model PoiMetric {
  id           BigInt                                 @id @default(autoincrement())
  poiId        String                                 @map("poi_id") @db.Uuid
  eventType    String                                 @map("event_type") @db.VarChar(40)
  userLocation Unsupported("geometry(Point, 4326)")?  @map("user_location")
  createdAt    DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)

  poi          Poi                                    @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([poiId, createdAt], name: "idx_poi_metrics_poi_date")
  @@map("poi_metrics")
}
